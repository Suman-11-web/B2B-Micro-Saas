# B2B Micro-SaaS - Production Environment Template
# NEVER commit actual secrets. Use AWS Secrets Manager / SSM Parameter Store in production.
# This file documents the REQUIRED variables for production deployment.

# ===========================================
# Application
# ===========================================
APP_NAME="B2B Micro-SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com

# ===========================================
# Database (RDS PostgreSQL)
# ===========================================
# Set via AWS Secrets Manager: rds!db-xxxxx
DB_HOST=
DB_PORT=5432
DB_NAME=b2b
DB_USER=
DB_PASSWORD=
# DATABASE_URL is constructed from above in settings

# ===========================================
# Redis (ElastiCache)
# ===========================================
# Set via AWS Secrets Manager: elasticache!cluster-xxxxx
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL constructed from above

# ===========================================
# JWT / Auth
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ===========================================
# AWS
# ===========================================
AWS_REGION=us-east-1
# AWS credentials provided via IAM task role (no keys in env)
S3_BUCKET=b2b-microsaas-prod
S3_ENDPOINT=
KMS_KEY_ID=arn:aws:kms:us-east-1:xxxxxx:key/xxxx-xxxx-xxxx-xxxx

# ===========================================
# OpenAI / LLM
# ===========================================
# Set via AWS Secrets Manager
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o
CHAT_MODEL_FALLBACK=gpt-4o-mini

# ===========================================
# Celery
# ===========================================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===========================================
# Stripe (Global Billing)
# ===========================================
# Set via AWS Secrets Manager
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================================
# Razorpay (INR Billing)
# ===========================================
# Set via AWS Secrets Manager
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===========================================
# R Service
# ===========================================
R_SERVICE_URL=https://rservice.yourdomain.com
R_SERVICE_TIMEOUT=60

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com

# ===========================================
# Email (SES or SMTP)
# ===========================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="B2B Micro-SaaS <noreply@yourdomain.com>"

# ===========================================
# Sentry
# ===========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ===========================================
# CloudFront / CDN
# ===========================================
CLOUDFRONT_DOMAIN=xxx.cloudfront.net