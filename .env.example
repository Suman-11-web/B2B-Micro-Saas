# B2B Micro-SaaS - Local Development Environment
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
APP_NAME="B2B Micro-SaaS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=b2b
DB_USER=b2b
DB_PASSWORD=b2bpassword
DATABASE_URL=postgresql://b2b:b2bpassword@localhost:5432/b2b

# ===========================================
# Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0

# ===========================================
# JWT / Auth
# ===========================================
JWT_SECRET_KEY=dev-secret-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ===========================================
# AWS / LocalStack (Local Development)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=b2b-microsaas-dev
S3_ENDPOINT=http://localhost:4566
KMS_KEY_ID=alias/b2b-dev

# ===========================================
# MinIO (S3 Compatible - Alternative to LocalStack)
# ===========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=b2b-microsaas-dev

# ===========================================
# OpenAI / LLM
# ===========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o
CHAT_MODEL_FALLBACK=gpt-4o-mini

# ===========================================
# Celery
# ===========================================
CELERY_BROKER_URL=redis://:redispassword@localhost:6379/1
CELERY_RESULT_BACKEND=db+postgresql://b2b:b2bpassword@localhost:5432/b2b

# ===========================================
# Stripe (Global Billing)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# Razorpay (INR Billing)
# ===========================================
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# R Service
# ===========================================
R_SERVICE_URL=http://localhost:8001
R_SERVICE_TIMEOUT=60

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Email (for password reset, invites)
# ===========================================
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="B2B Micro-SaaS <noreply@localhost>"

# ===========================================
# Sentry (Optional - Error Tracking)
# ===========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development