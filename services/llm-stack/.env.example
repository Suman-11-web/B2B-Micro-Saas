# Self-Hosted LLM Stack Environment Configuration
JWT_SECRET="change-me-to-a-32-char-random-secret-key"
LLM_GATEWAY_API_KEY="sk-selfhosted-internal-key-change-me"
LLM_GATEWAY_PORT=8100

# Inference backend: vLLM on GPU (http://vllm:8001) or Ollama on CPU (http://ollama:11434)
VLLM_URL="http://vllm:8001"
RAG_URL="http://rag:8002"
LLM_API_URL="http://gateway:8100"

# Model selection (Hugging Face repo ID)
VLLM_MODEL_KEY="qwen2.5-7b-instruct"
VLLM_PRIMARY_MODEL="Qwen/Qwen2.5-7B-Instruct"
CHAT_MODEL="qwen2.5-7b-instruct"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Optional Hugging Face token (required for gated models like Meta Llama 3.1)
HF_TOKEN=""

# PostgreSQL connection for RAG document storage
DATABASE_URL="postgresql://b2b:b2bpassword@postgres:5432/b2b"
RATE_LIMIT=120
